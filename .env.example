# Copia este archivo a .env y edita los valores
# Nunca compartas el .env en público

# Contraseña del panel de administrador
ADMIN_PASSWORD=pon-una-clave-segura-aqui

# ── Motor de IA ──────────────────────────────────────────────────────────────
# Proveedor de IA: gemini | openai. Si defines GEMINI_API_KEY y no pones AI_PROVIDER,
# usa gemini automáticamente. Si solo hay OPENAI_API_KEY, usa openai.
# El otro proveedor (si su clave existe) queda como RESPALDO automático.
# AI_PROVIDER=gemini

# Clave de Google AI Studio (Gemini). Consíguela gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelos Gemini (opcionales; cambia solo si Google renombra los modelos)
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Clave de OpenAI (respaldo o motor principal). Sin ninguna clave, funciona en modo local.
OPENAI_API_KEY=sk-...

# Puerto local (opcional, default 5174)
# PORT=5174
